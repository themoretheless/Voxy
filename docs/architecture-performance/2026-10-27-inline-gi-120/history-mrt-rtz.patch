+/// The legacy module keeps its original resource interface, including compute
+/// and world-query fallbacks. Only the qualified raster variant reads records.
+fn archive_shader_source_with_history(packed: bool) -> Result<String, crate::ComputeError> {
+    let mut source = archive_shader_source();
+    if !packed {
+        return Ok(source);
+    }
+    let replacements = [
+        (
+            "@group(2) @binding(8) var computed_gi:texture_2d<f32>;",
+            "@group(2) @binding(8) var packed_history:texture_2d<u32>;",
+        ),
+        (
+            "textureLoad(computed_gi,vec2<i32>(f.clip.xy),0)",
+            "vec4<f32>(0.)",
+        ),
+        (
+            "    var source=pixel;",
+            "    var source=pixel;var history_record=ArchiveHistoryRecord(0u,0u,0u);",
+        ),
+        (
+            "     let stored_depth=textureLoad(opaque_history_depth,source,0);",
+            "     let words=textureLoad(packed_history,source,0).xyz;history_record=ArchiveHistoryRecord(words.x,words.y,words.z);let stored_depth=bitcast<f32>(history_record.depth);",
+        ),
+        (
+            "    return vec4<f32>(textureLoad(background,source,0).rgb/camera.viewport.z,fade);",
+            "    if history {return vec4<f32>(archive_history_record_colour(history_record)/camera.viewport.z,fade);}\n    return vec4<f32>(textureLoad(background,source,0).rgb/camera.viewport.z,fade);",
+        ),
+    ];
+    for (needle, replacement) in replacements {
+        if !source.contains(needle) {
+            return Err(crate::ComputeError::Validation(
+                "original history specialization marker missing".into(),
+            ));
+        }
+        source = source.replacen(needle, replacement, 1);
+    }
+    source.push_str(r#"
+@fragment fn fs_opaque_history(f:Fragment,@builtin(front_facing) front:bool)->ArchiveHistoryOutput {return archive_history_output(shade(f,front,textureSample(diffuse_map,material_sampler,surface_uv(f))),textureLoad(scene_depth,vec2<i32>(f.clip.xy),0));}
+@fragment fn fs_main_history(f:Fragment,@builtin(front_facing) front:bool)->ArchiveHistoryOutput {let tex=textureSample(diffuse_map,material_sampler,surface_uv(f));if material.surface.w>=0.&&tex.a*material.diffuse.a<material.surface.w {discard;}return archive_history_output(shade(f,front,tex),textureLoad(scene_depth,vec2<i32>(f.clip.xy),0));}
+"#);
+    Ok(format!(
+        "{}\n{}",
+        include_str!("archive_history_record.wgsl"),
+        source
+    ))
+}
+#[cfg(test)]
+mod packed_history_shader_tests {
+    #[test]
+    fn specialization_preserves_legacy_module_and_validates_native_reader() {
+        assert_eq!(
+            super::archive_shader_source_with_history(false).unwrap(),
+            super::archive_shader_source()
+        );
+        let source = super::archive_shader_source_with_history(true).unwrap();
+        let module = naga::front::wgsl::parse_str(&source).unwrap();
+        naga::valid::Validator::new(
+            naga::valid::ValidationFlags::all(),
+            naga::valid::Capabilities::all(),
+        )
+        .validate(&module)
+        .unwrap();
+    }
