new file mode 100644
index 000000000..37e2c0031
--- /dev/null
+++ b/crates/voxy_render/src/archive_packed_history.rs
@@ -0,0 +1,265 @@
+//! Optional exact history MRT, produced by opaque shading without another scan.
+//! Formats and bindings stay here; core owns allocation and memory accounting.
+use crate::{ComputeError, ComputeMemoryBudget, ComputeStorage};
+use std::sync::Arc;
+#[derive(Debug)]
+pub(super) struct PackedHistory {
+    textures: Option<[Arc<voxy_gpu_core::ManagedTexture>; 2]>,
+    views: Option<[wgpu::TextureView; 2]>,
+    marker: Option<(ComputeStorage, wgpu::ComputePipeline, [wgpu::BindGroup; 2])>,
+    check: Option<wgpu::ComputePipeline>,
+    read: usize,
+    width: u32,
+    height: u32,
+}
+impl PackedHistory {
+    pub(super) fn new(
+        device: &wgpu::Device,
+        width: u32,
+        height: u32,
+        requested: bool,
+    ) -> Result<Self, ComputeError> {
+        let info = device.adapter_info();
+        let enabled = requested
+            && cfg!(all(target_os = "macos", target_arch = "aarch64"))
+            && info.backend == wgpu::Backend::Metal
+            && info.device_type == wgpu::DeviceType::IntegratedGpu
+            && device.limits().max_color_attachment_bytes_per_sample >= 24
+            && width > 0
+            && height > 0
+            && width <= device.limits().max_texture_dimension_2d
+            && height <= device.limits().max_texture_dimension_2d;
+        let mut result = Self {
+            textures: None,
+            views: None,
+            marker: None,
+            check: None,
+            read: 0,
+            width,
+            height,
+        };
+        if !enabled {
+            return Ok(result);
+        }
+        let allocate = || {
+            ComputeMemoryBudget::for_device(device).allocate_texture(&wgpu::TextureDescriptor {
+                label: Some("paired opaque history MRT"),
+                size: wgpu::Extent3d {
+                    width,
+                    height,
+                    depth_or_array_layers: 1,
+                },
+                mip_level_count: 1,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format: wgpu::TextureFormat::Rgba32Uint,
+                usage: wgpu::TextureUsages::RENDER_ATTACHMENT
+                    | wgpu::TextureUsages::TEXTURE_BINDING
+                    | wgpu::TextureUsages::COPY_SRC,
+                view_formats: &[],
+            })
+        };
+        let allocated = (|| Ok::<_, ComputeError>([allocate()?, allocate()?]))();
+        let textures = match allocated {
+            Ok(t) => t,
+            Err(ComputeError::MemoryBudget) => return Ok(result),
+            Err(e) => return Err(e),
+        };
+        let views = std::array::from_fn(|i| textures[i].create_view(&Default::default()));
+        let source = concat!(
+            include_str!("archive_history_record.wgsl"),
+            include_str!("archive_history_pack.wgsl")
+        );
+        let shader = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("history MRT word oracle"),
+            source: wgpu::ShaderSource::Wgsl(source.into()),
+        });
+        result.check = Some(
+            device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
+                label: None,
+                layout: None,
+                module: &shader,
+                entry_point: Some("check_history"),
+                compilation_options: Default::default(),
+                cache: None,
+            }),
+        );
+        if device.features().contains(wgpu::Features::TIMESTAMP_QUERY) {
+            let [marker] = ComputeMemoryBudget::for_device(device).allocate_buffers([
+                voxy_gpu_core::ManagedBufferDescriptor {
+                    label: "history completion marker",
+                    size: 4,
+                    contents: None,
+                    usage: wgpu::BufferUsages::STORAGE,
+                },
+            ])?;
+            let shader = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+                label: None,
+                source: wgpu::ShaderSource::Wgsl(
+                    include_str!("archive_history_marker.wgsl").into(),
+                ),
+            });
+            let pipeline = device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
+                label: None,
+                layout: None,
+                module: &shader,
+                entry_point: Some("mark"),
+                compilation_options: Default::default(),
+                cache: None,
+            });
+            let groups = std::array::from_fn(|i| {
+                device.create_bind_group(&wgpu::BindGroupDescriptor {
+                    label: None,
+                    layout: &pipeline.get_bind_group_layout(0),
+                    entries: &[
+                        wgpu::BindGroupEntry {
+                            binding: 0,
+                            resource: wgpu::BindingResource::TextureView(&views[i]),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 1,
+                            resource: marker.as_entire_binding(),
+                        },
+                    ],
+                })
+            });
+            result.marker = Some((marker, pipeline, groups));
+        }
+        result.textures = Some(textures);
+        result.views = Some(views);
+        Ok(result)
+    }
+    pub(super) fn enabled(&self) -> bool {
+        self.textures.is_some()
+    }
+    pub(super) fn bytes(&self) -> u64 {
+        if self.enabled() {
+            u64::from(self.width) * u64::from(self.height) * 32
+                + self.marker.as_ref().map_or(0, |m| m.0.size())
+        } else {
+            0
+        }
+    }
+    pub(super) fn read_index(&self) -> usize {
+        self.read
+    }
+    pub(super) fn view(&self, index: usize) -> Option<&wgpu::TextureView> {
+        self.views.as_ref().map(|v| &v[index])
+    }
+    pub(super) fn write_view(&self) -> Option<&wgpu::TextureView> {
+        self.view(self.read ^ 1)
+    }
+    pub(super) fn advance(&mut self) {
+        if self.enabled() {
+            self.read ^= 1;
+        }
+    }
+    pub(super) fn clear() -> wgpu::Color {
+        let rg = u32::from(half::f16::from_f32(0.22).to_bits())
+            | (u32::from(half::f16::from_f32(0.35).to_bits()) << 16);
+        let blue = half::f16::from_f32(0.55).to_f32().to_bits();
+        wgpu::Color {
+            r: f64::from(rg),
+            g: f64::from(blue),
+            b: f64::from(1f32.to_bits()),
+            a: 0.,
+        }
+    }
+    pub(super) fn encode(
+        &self,
+        encoder: &mut wgpu::CommandEncoder,
+        timestamps: Option<(&wgpu::QuerySet, u32)>,
+    ) {
+        let (Some((_, pipeline, groups)), Some((set, start))) = (&self.marker, timestamps) else {
+            return;
+        };
+        let mut pass = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor {
+            label: Some("history store completion timestamp"),
+            timestamp_writes: Some(wgpu::ComputePassTimestampWrites {
+                query_set: set,
+                beginning_of_pass_write_index: Some(start),
+                end_of_pass_write_index: Some(start + 1),
+            }),
+        });
+        pass.set_pipeline(pipeline);
+        pass.set_bind_group(0, &groups[self.read ^ 1], &[]);
+        pass.dispatch_workgroups(1, 1, 1);
+    }
+    pub(super) fn validate(
+        &self,
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        colour: &wgpu::Texture,
+        depth: &wgpu::Texture,
+    ) -> Result<Option<[u32; 4]>, Box<dyn std::error::Error>> {
+        let Some(pipeline) = &self.check else {
+            return Ok(None);
+        };
+        let [errors, read] = ComputeMemoryBudget::for_device(device).allocate_buffers([
+            voxy_gpu_core::ManagedBufferDescriptor {
+                label: "history word mismatch counts",
+                size: 52,
+                contents: Some(&[0; 52]),
+                usage: wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_SRC,
+            },
+            voxy_gpu_core::ManagedBufferDescriptor {
+                label: "history mismatch readback",
+                size: 52,
+                contents: None,
+                usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+            },
+        ])?;
+        let group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: None,
+            layout: &pipeline.get_bind_group_layout(0),
+            entries: &[
+                wgpu::BindGroupEntry {
+                    binding: 0,
+                    resource: wgpu::BindingResource::TextureView(
+                        &colour.create_view(&Default::default()),
+                    ),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 1,
+                    resource: wgpu::BindingResource::TextureView(
+                        &depth.create_view(&Default::default()),
+                    ),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 2,
+                    resource: wgpu::BindingResource::TextureView(self.view(self.read).unwrap()),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 3,
+                    resource: errors.as_entire_binding(),
+                },
+            ],
+        });
+        let mut encoder = device.create_command_encoder(&Default::default());
+        {
+            let mut pass = encoder.begin_compute_pass(&Default::default());
+            pass.set_pipeline(pipeline);
+            pass.set_bind_group(0, &group, &[]);
+            pass.dispatch_workgroups(self.width.div_ceil(8), self.height.div_ceil(8), 1);
+        }
+        encoder.copy_buffer_to_buffer(&errors, 0, &read, 0, 52);
+        let submission = queue.submit([encoder.finish()]);
+        let (send, receive) = std::sync::mpsc::channel();
+        read.slice(..).map_async(wgpu::MapMode::Read, move |r| {
+            let _ = send.send(r);
+        });
+        device.poll(wgpu::PollType::Wait {
+            submission_index: Some(submission),
+            timeout: None,
+        })?;
+        receive.recv()??;
+        let bytes = read.slice(..).get_mapped_range()?;
+        let counts = std::array::from_fn(|i| {
+            u32::from_le_bytes(bytes[i * 4..i * 4 + 4].try_into().unwrap())
+        });
+        eprintln!("HISTORY FIRST {:?}", bytemuck::cast_slice::<u8,u32>(&bytes));
+        drop(bytes);
+        read.unmap();
+        Ok(Some(counts))
+    }
+}
