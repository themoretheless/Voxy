@@ -0,0 +1,333 @@
+#[test]
+#[ignore = "native Metal history proof; VOXY_HISTORY_RECORD_PROOF must name a fresh directory"]
+#[cfg(target_os = "macos")]
+fn native_history_records_preserve_source_channels() -> Result<(), Box<dyn std::error::Error>> {
+    let root = std::path::PathBuf::from(
+        std::env::var_os("VOXY_HISTORY_RECORD_PROOF").ok_or("proof path required")?,
+    );
+    std::fs::create_dir(&root)?;
+    let instance = wgpu::Instance::new(wgpu::InstanceDescriptor {
+        backends: wgpu::Backends::METAL,
+        ..wgpu::InstanceDescriptor::new_without_display_handle()
+    });
+    let adapter = pollster::block_on(instance.request_adapter(&Default::default()))?;
+    let (device, queue) = pollster::block_on(adapter.request_device(&Default::default()))?;
+    let (w, h) = (256u32, 256u32);
+    let size = wgpu::Extent3d {
+        width: w,
+        height: h,
+        depth_or_array_layers: 1,
+    };
+    let finite = |v: u16| if v & 0x7c00 == 0x7c00 { 0 } else { v };
+    let colours: Vec<[u16; 4]> = (0..65536u32)
+        .map(|i| {
+            [
+                finite(i as u16),
+                finite((i as u16) ^ 0x8000),
+                finite((i as u16).rotate_left(5)),
+                0x3c00,
+            ]
+        })
+        .collect();
+    let mut seed = 0x9147_3e21u32;
+    let depths: Vec<f32> = (0..w * h)
+        .map(|_| {
+            seed = seed.wrapping_mul(1664525).wrapping_add(1013904223);
+            f32::from_bits(seed % 0x3f800001)
+        })
+        .collect();
+    let texture = |label, format, usage| {
+        device.create_texture(&wgpu::TextureDescriptor {
+            label: Some(label),
+            size,
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format,
+            usage,
+            view_formats: &[],
+        })
+    };
+    let colour = texture(
+        "source half radiance",
+        wgpu::TextureFormat::Rgba16Float,
+        wgpu::TextureUsages::COPY_DST | wgpu::TextureUsages::TEXTURE_BINDING,
+    );
+    let fixture = texture(
+        "depth fixture",
+        wgpu::TextureFormat::R32Float,
+        wgpu::TextureUsages::COPY_DST | wgpu::TextureUsages::TEXTURE_BINDING,
+    );
+    let depth = texture(
+        "original native opaque depth",
+        wgpu::TextureFormat::Depth32Float,
+        wgpu::TextureUsages::RENDER_ATTACHMENT
+            | wgpu::TextureUsages::TEXTURE_BINDING
+            | wgpu::TextureUsages::COPY_SRC,
+    );
+    let history = texture(
+        "legacy copied native depth",
+        wgpu::TextureFormat::Depth32Float,
+        wgpu::TextureUsages::COPY_DST | wgpu::TextureUsages::TEXTURE_BINDING,
+    );
+    for (image, bytes, stride) in [
+        (&colour, bytemuck::cast_slice(&colours), w * 8),
+        (&fixture, bytemuck::cast_slice(&depths), w * 4),
+    ] {
+        queue.write_texture(
+            image.as_image_copy(),
+            bytes,
+            wgpu::TexelCopyBufferLayout {
+                offset: 0,
+                bytes_per_row: Some(stride),
+                rows_per_image: Some(h),
+            },
+            size,
+        );
+    }
+    let depth_source = r"
+@group(0) @binding(0) var fixture:texture_2d<f32>;
+@vertex fn vertex(@builtin(vertex_index) i:u32)->@builtin(position) vec4<f32>{let p=array<vec2<f32>,3>(vec2<f32>(-1.,-1.),vec2<f32>(3.,-1.),vec2<f32>(-1.,3.));return vec4<f32>(p[i],0.,1.);}
+@fragment fn fragment(@builtin(position) p:vec4<f32>)->@builtin(frag_depth) f32{return textureLoad(fixture,vec2<i32>(p.xy),0).x;}
+";
+    let module = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+        label: None,
+        source: wgpu::ShaderSource::Wgsl(depth_source.into()),
+    });
+    let render = device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+        label: None,
+        layout: None,
+        vertex: wgpu::VertexState {
+            module: &module,
+            entry_point: Some("vertex"),
+            compilation_options: Default::default(),
+            buffers: &[],
+        },
+        primitive: Default::default(),
+        depth_stencil: Some(wgpu::DepthStencilState {
+            format: wgpu::TextureFormat::Depth32Float,
+            depth_write_enabled: Some(true),
+            depth_compare: Some(wgpu::CompareFunction::Always),
+            stencil: Default::default(),
+            bias: Default::default(),
+        }),
+        multisample: Default::default(),
+        fragment: Some(wgpu::FragmentState {
+            module: &module,
+            entry_point: Some("fragment"),
+            compilation_options: Default::default(),
+            targets: &[],
+        }),
+        multiview_mask: None,
+        cache: None,
+    });
+    let fixture_view = fixture.create_view(&Default::default());
+    let depth_view = depth.create_view(&Default::default());
+    let render_group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+        label: None,
+        layout: &render.get_bind_group_layout(0),
+        entries: &[wgpu::BindGroupEntry {
+            binding: 0,
+            resource: wgpu::BindingResource::TextureView(&fixture_view),
+        }],
+    });
+    let code = format!(
+        "{}\n{}",
+        include_str!("archive_history_record.wgsl"),
+        r"
+@group(0) @binding(0) var colour:texture_2d<f32>;
+@group(0) @binding(1) var original:texture_depth_2d;
+@group(0) @binding(2) var<storage,read_write> records:array<ArchiveHistoryRecord>;
+@group(0) @binding(3) var copied:texture_depth_2d;
+@group(0) @binding(4) var<storage,read_write> errors:array<vec4<u32>>;
+@compute @workgroup_size(8,8) fn pack(@builtin(global_invocation_id) id:vec3<u32>){let size=textureDimensions(colour);if any(id.xy>=size){return;}let p=vec2<i32>(id.xy);records[id.y*size.x+id.x]=archive_history_record(textureLoad(colour,p,0).rgb,textureLoad(original,p,0));}
+@compute @workgroup_size(8,8) fn check(@builtin(global_invocation_id) id:vec3<u32>){let size=textureDimensions(colour);if any(id.xy>=size){return;}let p=vec2<i32>(id.xy);let i=id.y*size.x+id.x;let record=records[i];let a=vec4<f32>(textureLoad(colour,p,0).rgb,textureLoad(copied,p,0));let b=vec4<f32>(archive_history_record_colour(record),bitcast<f32>(record.depth));errors[i]=vec4<u32>(select(vec4<u32>(0u),vec4<u32>(1u),bitcast<vec4<u32>>(a)!=bitcast<vec4<u32>>(b)));}
+"
+    );
+    let shader = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+        label: None,
+        source: wgpu::ShaderSource::Wgsl(code.clone().into()),
+    });
+    let pack = device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
+        label: None,
+        layout: None,
+        module: &shader,
+        entry_point: Some("pack"),
+        compilation_options: Default::default(),
+        cache: None,
+    });
+    let check = device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
+        label: None,
+        layout: None,
+        module: &shader,
+        entry_point: Some("check"),
+        compilation_options: Default::default(),
+        cache: None,
+    });
+    let records = device.create_buffer(&wgpu::BufferDescriptor {
+        label: None,
+        size: u64::from(w * h) * 12,
+        usage: wgpu::BufferUsages::STORAGE,
+        mapped_at_creation: false,
+    });
+    let bytes = u64::from(w * h) * 16;
+    let errors = device.create_buffer(&wgpu::BufferDescriptor {
+        label: None,
+        size: bytes,
+        usage: wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_SRC,
+        mapped_at_creation: false,
+    });
+    let read = device.create_buffer(&wgpu::BufferDescriptor {
+        label: None,
+        size: bytes,
+        usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+        mapped_at_creation: false,
+    });
+    let cv = colour.create_view(&Default::default());
+    let hv = history.create_view(&Default::default());
+    let pack_group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+        label: None,
+        layout: &pack.get_bind_group_layout(0),
+        entries: &[
+            wgpu::BindGroupEntry {
+                binding: 0,
+                resource: wgpu::BindingResource::TextureView(&cv),
+            },
+            wgpu::BindGroupEntry {
+                binding: 1,
+                resource: wgpu::BindingResource::TextureView(&depth_view),
+            },
+            wgpu::BindGroupEntry {
+                binding: 2,
+                resource: records.as_entire_binding(),
+            },
+        ],
+    });
+    let check_group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+        label: None,
+        layout: &check.get_bind_group_layout(0),
+        entries: &[
+            wgpu::BindGroupEntry {
+                binding: 0,
+                resource: wgpu::BindingResource::TextureView(&cv),
+            },
+            wgpu::BindGroupEntry {
+                binding: 2,
+                resource: records.as_entire_binding(),
+            },
+            wgpu::BindGroupEntry {
+                binding: 3,
+                resource: wgpu::BindingResource::TextureView(&hv),
+            },
+            wgpu::BindGroupEntry {
+                binding: 4,
+                resource: errors.as_entire_binding(),
+            },
+        ],
+    });
+    let mut encoder = device.create_command_encoder(&Default::default());
+    {
+        let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+            label: None,
+            color_attachments: &[],
+            depth_stencil_attachment: Some(wgpu::RenderPassDepthStencilAttachment {
+                view: &depth_view,
+                depth_ops: Some(wgpu::Operations {
+                    load: wgpu::LoadOp::Clear(1.),
+                    store: wgpu::StoreOp::Store,
+                }),
+                stencil_ops: None,
+            }),
+            ..Default::default()
+        });
+        pass.set_pipeline(&render);
+        pass.set_bind_group(0, &render_group, &[]);
+        pass.draw(0..3, 0..1);
+    }
+    encoder.copy_texture_to_texture(depth.as_image_copy(), history.as_image_copy(), size);
+    for (pipeline, group) in [(&pack, &pack_group), (&check, &check_group)] {
+        let mut pass = encoder.begin_compute_pass(&Default::default());
+        pass.set_pipeline(pipeline);
+        pass.set_bind_group(0, group, &[]);
+        pass.dispatch_workgroups(w.div_ceil(8), h.div_ceil(8), 1);
+    }
+    encoder.copy_buffer_to_buffer(&errors, 0, &read, 0, bytes);
+    let submission = queue.submit([encoder.finish()]);
+    device.poll(wgpu::PollType::Wait {
+        submission_index: Some(submission),
+        timeout: None,
+    })?;
+    let (tx, rx) = std::sync::mpsc::channel();
+    read.slice(..)
+        .map_async(wgpu::MapMode::Read, move |r| tx.send(r).unwrap());
+    device.poll(wgpu::PollType::wait_indefinitely())?;
+    rx.recv()??;
+    let mapped = read.slice(..).get_mapped_range()?;
+    let words: &[[u32; 4]] = bytemuck::cast_slice(&mapped);
+    let mismatches: [u64; 4] = std::array::from_fn(|c| words.iter().map(|w| u64::from(w[c])).sum());
+    std::fs::write(root.join("oracle.wgsl"), code)?;
+    std::fs::write(
+        root.join("proof.json"),
+        serde_json::to_vec_pretty(
+            &serde_json::json!({"pixels":w*h,"source":"all finite half patterns including signed zeros and subnormals; random native Depth32 values, legacy copied depth reference","channel_word_mismatches":mismatches,"record_bytes":12,"adapter":format!("{:?}",adapter.get_info()),"colour_input_blake3":blake3::hash(bytemuck::cast_slice(&colours)).to_hex().to_string(),"depth_input_blake3":blake3::hash(bytemuck::cast_slice(&depths)).to_hex().to_string()}),
+        )?,
+    )?;
+    assert_eq!(mismatches, [0; 4]);
+    Ok(())
+}
+
+#[test]
+#[ignore = "native MRT rounding proof; VOXY_HISTORY_MRT_PROOF must name a fresh directory"]
+#[cfg(all(target_os = "macos", target_arch = "aarch64"))]
+fn native_mrt_matches_original_target_rounding() -> Result<(), Box<dyn std::error::Error>> {
+    let root=std::path::PathBuf::from(std::env::var_os("VOXY_HISTORY_MRT_PROOF").ok_or("proof path required")?);
+    std::fs::create_dir(&root)?;
+    let instance=wgpu::Instance::new(wgpu::InstanceDescriptor {backends:wgpu::Backends::METAL,..wgpu::InstanceDescriptor::new_without_display_handle()});
