+/// The legacy module keeps its original resource interface, including compute
+/// and world-query fallbacks. Only the qualified raster variant reads records.
+fn archive_shader_source_with_history(packed: bool) -> Result<String,crate::ComputeError> {
+    let mut source=archive_shader_source();
+    if !packed {return Ok(source);}
+    let replacements=[
+        ("@group(2) @binding(0) var background:","@group(2) @binding(11) var<storage,read> packed_history:array<ArchiveHistoryRecord>;\n@group(2) @binding(0) var background:"),
+        ("    var source=pixel;","    var source=pixel;var history_record=ArchiveHistoryRecord(0u,0u,0u);"),
+        ("     let stored_depth=textureLoad(opaque_history_depth,source,0);","     history_record=packed_history[u32(source.y)*u32(camera.viewport.x)+u32(source.x)];let stored_depth=bitcast<f32>(history_record.depth);"),
+        ("    return vec4<f32>(textureLoad(background,source,0).rgb/camera.viewport.z,fade);","    if history {return vec4<f32>(archive_history_record_colour(history_record)/camera.viewport.z,fade);}\n    return vec4<f32>(textureLoad(background,source,0).rgb/camera.viewport.z,fade);")
+    ];
+    for (needle,replacement) in replacements {
+        if !source.contains(needle) {return Err(crate::ComputeError::Validation("original history specialization marker missing".into()));}
+        source=source.replacen(needle,replacement,1);
+    }
+    Ok(format!("{}\n{}",include_str!("archive_history_record.wgsl"),source))
+}
