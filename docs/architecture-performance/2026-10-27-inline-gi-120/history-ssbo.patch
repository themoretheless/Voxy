+/// Include a late history-producing pass without changing shading intervals.
+/// Missing/stale tail samples invalidate the sample instead of omitting work.
+pub(crate) fn include_completion_tail(ticks: &mut [u64], tail: [u64;2]) -> bool {
+    if ticks.len()<6 || ticks[5]==0 || ticks[5]==u64::MAX || tail.iter().any(|&t|t==0||t==u64::MAX) || tail[1]<tail[0] || tail[1]<=ticks[0] {return false;}
+    ticks[5]=ticks[5].max(tail[1]);true
+}
+#[cfg(test)]
+mod completion_tail_tests {
+    use super::*;
+    #[test] fn includes_late_work_without_relabelling_shading() {let mut t=[100,120,200,220,260,300];assert!(include_completion_tail(&mut t,[290,350]));assert_eq!(decode(&t,1_000_000.),Some([250.,80.,40.]));}
+    #[test] fn overlapping_tail_keeps_later_display_end() {let mut t=[100,120,200,220,260,300];assert!(include_completion_tail(&mut t,[200,250]));assert_eq!(decode(&t,1_000_000.),Some([200.,80.,40.]));}
+    #[test] fn missing_or_stale_work_cannot_silently_disappear() {for tail in [[0,350],[290,0],[350,290],[20,90],[290,u64::MAX]] {let mut t=[100,120,200,220,260,300];assert!(!include_completion_tail(&mut t,tail));assert_eq!(t,[100,120,200,220,260,300]);}}
+}
diff --git a/crates/voxy_render/src/archive_history_pack.wgsl b/crates/voxy_render/src/archive_history_pack.wgsl
new file mode 100644
index 000000000..918123500
--- /dev/null
+++ b/crates/voxy_render/src/archive_history_pack.wgsl
@@ -0,0 +1,20 @@
+@group(0) @binding(0) var record_colour:texture_2d<f32>;
+@group(0) @binding(1) var record_depth:texture_depth_2d;
+@group(0) @binding(2) var<storage,read_write> record_data:array<ArchiveHistoryRecord>;
+@group(0) @binding(3) var<storage,read_write> record_errors:array<atomic<u32>,4>;
+@compute @workgroup_size(8,8)
+fn pack_history(@builtin(global_invocation_id) id:vec3<u32>) {
+ let size=textureDimensions(record_colour);if any(id.xy>=size) {return;}
+ let p=vec2<i32>(id.xy);
+ record_data[id.y*size.x+id.x]=archive_history_record(textureLoad(record_colour,p,0).rgb,textureLoad(record_depth,p,0));
+}
+// Qualification only: compare the current packed records with both original
+// GPU textures, after their producer submission has completed.
+@compute @workgroup_size(8,8)
+fn check_history(@builtin(global_invocation_id) id:vec3<u32>) {
+ let size=textureDimensions(record_colour);if any(id.xy>=size) {return;}
+ let p=vec2<i32>(id.xy);let record=record_data[id.y*size.x+id.x];
+ let expected=bitcast<vec4<u32>>(vec4<f32>(textureLoad(record_colour,p,0).rgb,textureLoad(record_depth,p,0)));
+ let actual=bitcast<vec4<u32>>(vec4<f32>(archive_history_record_colour(record),bitcast<f32>(record.depth)));
+ for(var c=0u;c<4u;c++) {if expected[c]!=actual[c] {atomicAdd(&record_errors[c],1u);}}
+}
diff --git a/crates/voxy_render/src/archive_history_record.wgsl b/crates/voxy_render/src/archive_history_record.wgsl
new file mode 100644
index 000000000..ed7b1254b
--- /dev/null
+++ b/crates/voxy_render/src/archive_history_record.wgsl
@@ -0,0 +1,9 @@
+// Original RGBA16Float radiance and Depth32Float history, without loss.
+// Blue stays a Float32 word; R/G were already half values at their source.
+struct ArchiveHistoryRecord {rg:u32,blue:u32,depth:u32}
+fn archive_history_record(colour:vec3<f32>,depth:f32)->ArchiveHistoryRecord {
+ return ArchiveHistoryRecord(pack2x16float(colour.rg),bitcast<u32>(colour.b),bitcast<u32>(depth));
+}
+fn archive_history_record_colour(record:ArchiveHistoryRecord)->vec3<f32> {
+ return vec3<f32>(unpack2x16float(record.rg),bitcast<f32>(record.blue));
+}
diff --git a/crates/voxy_render/src/archive_history_record_tests.rs b/crates/voxy_render/src/archive_history_record_tests.rs
new file mode 100644
index 000000000..057e59851
--- /dev/null
+++ b/crates/voxy_render/src/archive_history_record_tests.rs
@@ -0,0 +1,277 @@
+#[test]
+#[ignore = "native Metal history proof; VOXY_HISTORY_RECORD_PROOF must name a fresh directory"]
+#[cfg(target_os = "macos")]
+fn native_history_records_preserve_source_channels() -> Result<(), Box<dyn std::error::Error>> {
+    let root = std::path::PathBuf::from(
+        std::env::var_os("VOXY_HISTORY_RECORD_PROOF").ok_or("proof path required")?,
+    );
+    std::fs::create_dir(&root)?;
+    let instance = wgpu::Instance::new(wgpu::InstanceDescriptor {
+        backends: wgpu::Backends::METAL,
+        ..wgpu::InstanceDescriptor::new_without_display_handle()
+    });
+    let adapter = pollster::block_on(instance.request_adapter(&Default::default()))?;
+    let (device, queue) = pollster::block_on(adapter.request_device(&Default::default()))?;
+    let (w, h) = (256u32, 256u32);
+    let size = wgpu::Extent3d {
+        width: w,
+        height: h,
+        depth_or_array_layers: 1,
+    };
+    let finite = |v: u16| if v & 0x7c00 == 0x7c00 { 0 } else { v };
+    let colours: Vec<[u16; 4]> = (0..65536u32)
+        .map(|i| {
+            [
+                finite(i as u16),
+                finite((i as u16) ^ 0x8000),
+                finite((i as u16).rotate_left(5)),
+                0x3c00,
+            ]
+        })
+        .collect();
+    let mut seed = 0x9147_3e21u32;
+    let depths: Vec<f32> = (0..w * h)
+        .map(|_| {
+            seed = seed.wrapping_mul(1664525).wrapping_add(1013904223);
+            f32::from_bits(seed % 0x3f800001)
+        })
+        .collect();
+    let texture = |label, format, usage| {
+        device.create_texture(&wgpu::TextureDescriptor {
+            label: Some(label),
+            size,
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format,
+            usage,
+            view_formats: &[],
+        })
+    };
+    let colour = texture(
+        "source half radiance",
+        wgpu::TextureFormat::Rgba16Float,
+        wgpu::TextureUsages::COPY_DST | wgpu::TextureUsages::TEXTURE_BINDING,
+    );
+    let fixture = texture(
+        "depth fixture",
+        wgpu::TextureFormat::R32Float,
+        wgpu::TextureUsages::COPY_DST | wgpu::TextureUsages::TEXTURE_BINDING,
+    );
+    let depth = texture(
+        "original native opaque depth",
+        wgpu::TextureFormat::Depth32Float,
+        wgpu::TextureUsages::RENDER_ATTACHMENT
+            | wgpu::TextureUsages::TEXTURE_BINDING
+            | wgpu::TextureUsages::COPY_SRC,
+    );
+    let history = texture(
+        "legacy copied native depth",
+        wgpu::TextureFormat::Depth32Float,
+        wgpu::TextureUsages::COPY_DST | wgpu::TextureUsages::TEXTURE_BINDING,
+    );
+    for (image, bytes, stride) in [
+        (&colour, bytemuck::cast_slice(&colours), w * 8),
+        (&fixture, bytemuck::cast_slice(&depths), w * 4),
+    ] {
+        queue.write_texture(
+            image.as_image_copy(),
+            bytes,
+            wgpu::TexelCopyBufferLayout {
+                offset: 0,
+                bytes_per_row: Some(stride),
+                rows_per_image: Some(h),
+            },
+            size,
+        );
+    }
+    let depth_source = r"
+@group(0) @binding(0) var fixture:texture_2d<f32>;
+@vertex fn vertex(@builtin(vertex_index) i:u32)->@builtin(position) vec4<f32>{let p=array<vec2<f32>,3>(vec2<f32>(-1.,-1.),vec2<f32>(3.,-1.),vec2<f32>(-1.,3.));return vec4<f32>(p[i],0.,1.);}
+@fragment fn fragment(@builtin(position) p:vec4<f32>)->@builtin(frag_depth) f32{return textureLoad(fixture,vec2<i32>(p.xy),0).x;}
+";
+    let module = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+        label: None,
+        source: wgpu::ShaderSource::Wgsl(depth_source.into()),
+    });
+    let render = device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+        label: None,
+        layout: None,
+        vertex: wgpu::VertexState {
+            module: &module,
+            entry_point: Some("vertex"),
+            compilation_options: Default::default(),
+            buffers: &[],
+        },
+        primitive: Default::default(),
+        depth_stencil: Some(wgpu::DepthStencilState {
+            format: wgpu::TextureFormat::Depth32Float,
+            depth_write_enabled: Some(true),
+            depth_compare: Some(wgpu::CompareFunction::Always),
+            stencil: Default::default(),
+            bias: Default::default(),
+        }),
+        multisample: Default::default(),
+        fragment: Some(wgpu::FragmentState {
+            module: &module,
+            entry_point: Some("fragment"),
+            compilation_options: Default::default(),
+            targets: &[],
+        }),
+        multiview_mask: None,
+        cache: None,
+    });
+    let fixture_view = fixture.create_view(&Default::default());
+    let depth_view = depth.create_view(&Default::default());
+    let render_group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+        label: None,
+        layout: &render.get_bind_group_layout(0),
+        entries: &[wgpu::BindGroupEntry {
+            binding: 0,
+            resource: wgpu::BindingResource::TextureView(&fixture_view),
+        }],
+    });
+    let code = format!(
+        "{}\n{}",
+        include_str!("archive_history_record.wgsl"),
+        r"
+@group(0) @binding(0) var colour:texture_2d<f32>;
+@group(0) @binding(1) var original:texture_depth_2d;
+@group(0) @binding(2) var<storage,read_write> records:array<ArchiveHistoryRecord>;
+@group(0) @binding(3) var copied:texture_depth_2d;
+@group(0) @binding(4) var<storage,read_write> errors:array<vec4<u32>>;
+@compute @workgroup_size(8,8) fn pack(@builtin(global_invocation_id) id:vec3<u32>){let size=textureDimensions(colour);if any(id.xy>=size){return;}let p=vec2<i32>(id.xy);records[id.y*size.x+id.x]=archive_history_record(textureLoad(colour,p,0).rgb,textureLoad(original,p,0));}
+@compute @workgroup_size(8,8) fn check(@builtin(global_invocation_id) id:vec3<u32>){let size=textureDimensions(colour);if any(id.xy>=size){return;}let p=vec2<i32>(id.xy);let i=id.y*size.x+id.x;let record=records[i];let a=vec4<f32>(textureLoad(colour,p,0).rgb,textureLoad(copied,p,0));let b=vec4<f32>(archive_history_record_colour(record),bitcast<f32>(record.depth));errors[i]=vec4<u32>(select(vec4<u32>(0u),vec4<u32>(1u),bitcast<vec4<u32>>(a)!=bitcast<vec4<u32>>(b)));}
+"
+    );
+    let shader = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+        label: None,
+        source: wgpu::ShaderSource::Wgsl(code.clone().into()),
+    });
+    let pack = device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
+        label: None,
+        layout: None,
+        module: &shader,
+        entry_point: Some("pack"),
+        compilation_options: Default::default(),
+        cache: None,
+    });
+    let check = device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
+        label: None,
+        layout: None,
+        module: &shader,
+        entry_point: Some("check"),
+        compilation_options: Default::default(),
+        cache: None,
+    });
+    let records = device.create_buffer(&wgpu::BufferDescriptor {
+        label: None,
+        size: u64::from(w * h) * 12,
+        usage: wgpu::BufferUsages::STORAGE,
+        mapped_at_creation: false,
+    });
+    let bytes = u64::from(w * h) * 16;
+    let errors = device.create_buffer(&wgpu::BufferDescriptor {
+        label: None,
+        size: bytes,
+        usage: wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_SRC,
+        mapped_at_creation: false,
+    });
+    let read = device.create_buffer(&wgpu::BufferDescriptor {
+        label: None,
+        size: bytes,
+        usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+        mapped_at_creation: false,
+    });
+    let cv = colour.create_view(&Default::default());
+    let hv = history.create_view(&Default::default());
+    let pack_group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+        label: None,
+        layout: &pack.get_bind_group_layout(0),
+        entries: &[
+            wgpu::BindGroupEntry {
+                binding: 0,
+                resource: wgpu::BindingResource::TextureView(&cv),
+            },
+            wgpu::BindGroupEntry {
+                binding: 1,
+                resource: wgpu::BindingResource::TextureView(&depth_view),
+            },
+            wgpu::BindGroupEntry {
+                binding: 2,
+                resource: records.as_entire_binding(),
+            },
+        ],
+    });
+    let check_group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+        label: None,
+        layout: &check.get_bind_group_layout(0),
+        entries: &[
+            wgpu::BindGroupEntry {
+                binding: 0,
+                resource: wgpu::BindingResource::TextureView(&cv),
+            },
+            wgpu::BindGroupEntry {
+                binding: 2,
+                resource: records.as_entire_binding(),
+            },
+            wgpu::BindGroupEntry {
+                binding: 3,
+                resource: wgpu::BindingResource::TextureView(&hv),
+            },
+            wgpu::BindGroupEntry {
+                binding: 4,
+                resource: errors.as_entire_binding(),
+            },
+        ],
+    });
+    let mut encoder = device.create_command_encoder(&Default::default());
+    {
+        let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+            label: None,
+            color_attachments: &[],
+            depth_stencil_attachment: Some(wgpu::RenderPassDepthStencilAttachment {
+                view: &depth_view,
+                depth_ops: Some(wgpu::Operations {
+                    load: wgpu::LoadOp::Clear(1.),
+                    store: wgpu::StoreOp::Store,
+                }),
+                stencil_ops: None,
+            }),
+            ..Default::default()
+        });
+        pass.set_pipeline(&render);
+        pass.set_bind_group(0, &render_group, &[]);
+        pass.draw(0..3, 0..1);
+    }
+    encoder.copy_texture_to_texture(depth.as_image_copy(), history.as_image_copy(), size);
+    for (pipeline, group) in [(&pack, &pack_group), (&check, &check_group)] {
+        let mut pass = encoder.begin_compute_pass(&Default::default());
+        pass.set_pipeline(pipeline);
+        pass.set_bind_group(0, group, &[]);
+        pass.dispatch_workgroups(w.div_ceil(8), h.div_ceil(8), 1);
+    }
+    encoder.copy_buffer_to_buffer(&errors, 0, &read, 0, bytes);
+    let submission = queue.submit([encoder.finish()]);
+    device.poll(wgpu::PollType::Wait {
+        submission_index: Some(submission),
+        timeout: None,
+    })?;
+    let (tx, rx) = std::sync::mpsc::channel();
+    read.slice(..)
+        .map_async(wgpu::MapMode::Read, move |r| tx.send(r).unwrap());
+    device.poll(wgpu::PollType::wait_indefinitely())?;
+    rx.recv()??;
+    let mapped = read.slice(..).get_mapped_range()?;
+    let words: &[[u32; 4]] = bytemuck::cast_slice(&mapped);
+    let mismatches: [u64; 4] = std::array::from_fn(|c| words.iter().map(|w| u64::from(w[c])).sum());
+    std::fs::write(root.join("oracle.wgsl"), code)?;
+    std::fs::write(
+        root.join("proof.json"),
+        serde_json::to_vec_pretty(
+            &serde_json::json!({"pixels":w*h,"source":"all finite half patterns including signed zeros and subnormals; random native Depth32 values, legacy copied depth reference","channel_word_mismatches":mismatches,"record_bytes":12,"adapter":format!("{:?}",adapter.get_info()),"colour_input_blake3":blake3::hash(bytemuck::cast_slice(&colours)).to_hex().to_string(),"depth_input_blake3":blake3::hash(bytemuck::cast_slice(&depths)).to_hex().to_string()}),
+        )?,
+    )?;
+    assert_eq!(mismatches, [0; 4]);
+    Ok(())
+}
diff --git a/crates/voxy_render/src/archive_packed_history.rs b/crates/voxy_render/src/archive_packed_history.rs
new file mode 100644
index 000000000..61c70f3bf
--- /dev/null
+++ b/crates/voxy_render/src/archive_packed_history.rs
@@ -0,0 +1,219 @@
+//! Optional, bit-preserving co-location of original opaque radiance and depth.
+//! The 12-byte format belongs to the renderer; allocation/accounting uses core.
+use crate::{ComputeError, ComputeMemoryBudget, ComputeStorage};
+
+#[derive(Debug)]
+pub(super) struct PackedHistory {
+    pub(super) storage: ComputeStorage,
+    enabled: bool,
+    width: u32,
+    height: u32,
+    pipelines: Option<(wgpu::ComputePipeline, wgpu::ComputePipeline)>,
+    group: Option<wgpu::BindGroup>,
+}
+impl PackedHistory {
+    pub(super) fn new(
+        device: &wgpu::Device,
+        width: u32,
+        height: u32,
+        requested: bool,
+    ) -> Result<Self, ComputeError> {
+        let bytes = u64::from(width)
+            .checked_mul(u64::from(height))
+            .and_then(|n| n.checked_mul(12))
+            .ok_or(ComputeError::InvalidBuffer)?;
+        let info = device.adapter_info();
+        let enabled = requested
+            && cfg!(all(target_os = "macos", target_arch = "aarch64"))
+            && info.backend == wgpu::Backend::Metal
+            && info.device_type == wgpu::DeviceType::IntegratedGpu
+            && bytes > 0
+            && bytes <= device.limits().max_storage_buffer_binding_size
+            && bytes <= device.limits().max_buffer_size;
+        let [storage] = ComputeMemoryBudget::for_device(device).allocate_buffers([
+            voxy_gpu_core::ManagedBufferDescriptor {
+                label: "paired original opaque history",
+                size: if enabled { bytes } else { 12 },
+                contents: None,
+                usage: wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_SRC,
+            },
+        ])?;
+        Ok(Self {
+            storage,
+            enabled,
+            width,
+            height,
+            pipelines: None,
+            group: None,
+        })
+    }
+    pub(super) fn enabled(&self) -> bool {
+        self.enabled
+    }
+    fn shader(device: &wgpu::Device) -> wgpu::ShaderModule {
+        device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("lossless original history records"),
+            source: wgpu::ShaderSource::Wgsl(
+                concat!(
+                    include_str!("archive_history_record.wgsl"),
+                    include_str!("archive_history_pack.wgsl")
+                )
+                .into(),
+            ),
+        })
+    }
+    pub(super) fn connect(
+        &mut self,
+        device: &wgpu::Device,
+        colour: &wgpu::Texture,
+        depth: &wgpu::Texture,
+    ) -> Result<(), ComputeError> {
+        if !self.enabled {
+            return Ok(());
+        }
+        if colour.format() != wgpu::TextureFormat::Rgba16Float
+            || depth.format() != wgpu::TextureFormat::Depth32Float
+            || colour.width() != self.width
+            || colour.height() != self.height
+            || depth.size() != colour.size()
+        {
+            return Err(ComputeError::Validation(
+                "history records require original matching RGBA16Float/Depth32Float textures"
+                    .into(),
+            ));
+        }
+        let module = Self::shader(device);
+        let pipeline = |entry| {
+            device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
+                label: Some(entry),
+                layout: None,
+                module: &module,
+                entry_point: Some(entry),
+                compilation_options: Default::default(),
+                cache: None,
+            })
+        };
+        let pack = pipeline("pack_history");
+        let check = pipeline("check_history");
+        self.group = Some(device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("original history producers"),
+            layout: &pack.get_bind_group_layout(0),
+            entries: &[
+                wgpu::BindGroupEntry {
+                    binding: 0,
+                    resource: wgpu::BindingResource::TextureView(
+                        &colour.create_view(&Default::default()),
+                    ),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 1,
+                    resource: wgpu::BindingResource::TextureView(
+                        &depth.create_view(&Default::default()),
+                    ),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 2,
+                    resource: self.storage.as_entire_binding(),
+                },
+            ],
+        }));
+        self.pipelines = Some((pack, check));
+        Ok(())
+    }
+    pub(super) fn encode(
+        &self,
+        encoder: &mut wgpu::CommandEncoder,
+        timestamps: Option<(&wgpu::QuerySet, u32)>,
+    ) {
+        let Some((pipeline, _)) = &self.pipelines else {
+            return;
+        };
+        let mut pass = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor {
+            label: Some("original history co-location"),
+            timestamp_writes: timestamps.map(|(set, start)| wgpu::ComputePassTimestampWrites {
+                query_set: set,
+                beginning_of_pass_write_index: Some(start),
+                end_of_pass_write_index: Some(start + 1),
+            }),
+        });
+        pass.set_pipeline(pipeline);
+        pass.set_bind_group(0, self.group.as_ref().unwrap(), &[]);
+        pass.dispatch_workgroups(self.width.div_ceil(8), self.height.div_ceil(8), 1);
+    }
+    pub(super) fn validate(
+        &self,
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        colour: &wgpu::Texture,
+        depth: &wgpu::Texture,
+    ) -> Result<Option<[u32; 4]>, Box<dyn std::error::Error>> {
+        let Some((_, pipeline)) = &self.pipelines else {
+            return Ok(None);
+        };
+        let [errors, read] = ComputeMemoryBudget::for_device(device).allocate_buffers([
+            voxy_gpu_core::ManagedBufferDescriptor {
+                label: "history word mismatch counts",
+                size: 16,
+                contents: Some(&[0; 16]),
+                usage: wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_SRC,
+            },
+            voxy_gpu_core::ManagedBufferDescriptor {
+                label: "history mismatch readback",
+                size: 16,
+                contents: None,
+                usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+            },
+        ])?;
+        let group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: None,
+            layout: &pipeline.get_bind_group_layout(0),
+            entries: &[
+                wgpu::BindGroupEntry {
+                    binding: 0,
+                    resource: wgpu::BindingResource::TextureView(
+                        &colour.create_view(&Default::default()),
+                    ),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 1,
+                    resource: wgpu::BindingResource::TextureView(
+                        &depth.create_view(&Default::default()),
+                    ),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 2,
+                    resource: self.storage.as_entire_binding(),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 3,
+                    resource: errors.as_entire_binding(),
+                },
+            ],
+        });
+        let mut encoder = device.create_command_encoder(&Default::default());
+        {
+            let mut pass = encoder.begin_compute_pass(&Default::default());
+            pass.set_pipeline(pipeline);
+            pass.set_bind_group(0, &group, &[]);
+            pass.dispatch_workgroups(self.width.div_ceil(8), self.height.div_ceil(8), 1);
+        }
+        encoder.copy_buffer_to_buffer(&errors, 0, &read, 0, 16);
+        let submission = queue.submit([encoder.finish()]);
+        let (send, receive) = std::sync::mpsc::channel();
+        read.slice(..).map_async(wgpu::MapMode::Read, move |r| {
+            let _ = send.send(r);
+        });
+        device.poll(wgpu::PollType::Wait {
+            submission_index: Some(submission),
+            timeout: None,
+        })?;
+        receive.recv()??;
+        let bytes = read.slice(..).get_mapped_range()?;
+        let result = std::array::from_fn(|i| {
+            u32::from_le_bytes(bytes[i * 4..i * 4 + 4].try_into().unwrap())
+        });
+        drop(bytes);
+        read.unmap();
+        Ok(Some(result))
+    }
+}
