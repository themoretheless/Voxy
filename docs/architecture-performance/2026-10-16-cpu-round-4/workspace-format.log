+    pub fn residuals(&self, bytes: &[u8]) -> Result<Vec<ExperimentalFiveQrValue>, JointDotError> {
+        if bytes.len() != self.bytes().len() {
+            return Err(JointDotError::Output);
+        }
+        let words = bytes
+            .chunks_exact(4)
+            .map(|v| u32::from_le_bytes(v.try_into().unwrap()))
