+    #[doc(hidden)]
+    pub fn new_pixel_hierarchy(
+        device: &wgpu::Device,
+        depth: &wgpu::Texture,
+        width: u32,
+        height: u32,
+    ) -> Result<Self, ComputeError> {
+        Self::create(device, depth, width, height, true, true)
