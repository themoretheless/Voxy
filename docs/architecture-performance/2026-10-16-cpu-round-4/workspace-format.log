+        .enumerate()
+        .filter(|&(i, _)| i != 5 || ticks[5] > ticks[0])
+        .map(|(_, v)| *v)
+        .collect();
+    let scale = f64::from(period_ns) / 1e6;
+    base[0] = (*valid.iter().max()? - *valid.iter().min()?) as f64 * scale;
+    Some((base, gi, Some((ticks[11] - ticks[10]) as f64 * scale)))
