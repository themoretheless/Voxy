+pub(crate) fn ray_stage_index(
+    base: u32,
+    chunks: u32,
+    kind: u32,
+    tile: u32,
+    stage: u32,
+    end: bool,
+) -> u32 {
+    let ordinal = tile * 6 + stage * 2 + u32::from(end);
+    if ordinal == 0 {
+        8 + kind * 2
+    } else if ordinal == chunks * 6 - 1 {
+        9 + kind * 2
+    } else {
+        base + kind * (chunks * 6 - 2) + ordinal - 1
+    }
 }
-pub(crate) fn ray_stage_count(base:u32,chunks:u32)->Option<u32> {
