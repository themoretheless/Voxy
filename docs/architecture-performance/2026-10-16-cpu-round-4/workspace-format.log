+pub(crate) fn ray_stage_count(base: u32, chunks: u32) -> Option<u32> {
+    if chunks == 0 || (base != 10 && base != 12) {
+        return None;
+    }
+    base.checked_add(
+        chunks
+            .checked_mul(6)?
+            .checked_sub(2)?
+            .checked_mul(if base == 12 { 2 } else { 1 })?,
+    )
 }
-pub(crate) fn ray_stage_durations(ticks:&[u64],base:u32,chunks:u32,period:f32)->Option<Vec<[f64;3]>> {
- if ticks.len()!=ray_stage_count(base,chunks)? as usize || !period.is_finite() || period<=0. {return None;}
- let mut result=vec![[0.;3];if base==12 {2}else{1}];
- for (kind,values) in result.iter_mut().enumerate() {for tile in 0..chunks {for stage in 0..3 {
- let a=ticks[ray_stage_index(base,chunks,kind as u32,tile,stage,false) as usize];
- let b=ticks[ray_stage_index(base,chunks,kind as u32,tile,stage,true) as usize];
- if a==0||b==u64::MAX||b<a {return None;}
- values[stage as usize]+=(b-a) as f64*f64::from(period)/1e6;
- }}}
- Some(result)
+pub(crate) fn ray_stage_durations(
+    ticks: &[u64],
+    base: u32,
+    chunks: u32,
+    period: f32,
+) -> Option<Vec<[f64; 3]>> {
+    if ticks.len() != ray_stage_count(base, chunks)? as usize || !period.is_finite() || period <= 0.
+    {
+        return None;
+    }
+    let mut result = vec![[0.; 3]; if base == 12 { 2 } else { 1 }];
+    for (kind, values) in result.iter_mut().enumerate() {
+        for tile in 0..chunks {
+            for stage in 0..3 {
+                let a =
+                    ticks[ray_stage_index(base, chunks, kind as u32, tile, stage, false) as usize];
+                let b =
+                    ticks[ray_stage_index(base, chunks, kind as u32, tile, stage, true) as usize];
+                if a == 0 || b == u64::MAX || b < a {
+                    return None;
+                }
+                values[stage as usize] += (b - a) as f64 * f64::from(period) / 1e6;
+            }
+        }
+    }
+    Some(result)
 }
