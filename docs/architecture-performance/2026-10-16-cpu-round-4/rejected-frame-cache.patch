+#[cfg(test)]
+mod frame_cache_tests {
+    use super::*;
+    fn poses() -> Vec<[Mat4; BONES]> {
+        (0..240)
+            .map(|tick| {
+                std::array::from_fn(|bone| {
+                    Mat4::from_rotation_translation(
+                        glam::Quat::from_rotation_y(tick as f32 * 0.002 + bone as f32 * 0.03),
+                        Vec3::new(bone as f32 * 0.01, 1., tick as f32 * 0.001),
+                    )
+                })
+            })
+            .collect()
+    }
+    #[test]
+    fn shared_frames_preserve_complete_strand_history() {
+        for cat in [false, true] {
+            let groom = groom(cat).unwrap();
+            let mut before = CoatDynamics::new();
+            let mut after = CoatDynamics::new();
+            for pose in poses() {
+                assert_eq!(
+                    before.step_with_frame_cache(&groom, &pose, 1. / 60., false),
+                    after.step(&groom, &pose, 1. / 60.)
+                );
+                for (a, b) in before.strands.iter().zip(&after.strands) {
+                    assert_eq!(format!("{a:?}"), format!("{b:?}"));
+                }
+            }
+            let snapshot = format!("{after:?}");
+            assert!(after.step(&groom, &poses()[0], f32::NAN).is_err());
+            assert_eq!(snapshot, format!("{after:?}"));
+        }
+    }
+    #[test]
+    #[ignore = "manual CPU coat simulation paired benchmark"]
+    fn paired_coat_cpu_bench() {
+        use std::{hint::black_box, time::Instant};
+        let poses = poses();
+        for cat in [false, true] {
+            let groom = groom(cat).unwrap();
+            for round in 1..=5 {
+                let mut snapshots = Vec::new();
+                for (variant, cache) in if round % 2 == 1 {
+                    [("before", false), ("after", true)]
+                } else {
+                    [("after", true), ("before", false)]
+                } {
+                    let mut coat = CoatDynamics::new();
+                    let mut samples = Vec::new();
+                    for (tick, pose) in poses.iter().enumerate() {
+                        let start = Instant::now();
+                        coat.step_with_frame_cache(
+                            black_box(&groom),
+                            black_box(pose),
+                            1. / 60.,
+                            black_box(cache),
+                        )
+                        .unwrap();
+                        if tick >= 20 {
+                            samples.push(start.elapsed().as_secs_f64() * 1e6);
+                        }
+                    }
+                    snapshots.push(format!("{coat:?}"));
+                    samples.sort_by(f64::total_cmp);
+                    println!("COAT_PAIR,{round},{variant},{cat},{:.6}", samples[110]);
+                }
+                assert_eq!(snapshots[0], snapshots[1]);
+            }
+        }
+    }
