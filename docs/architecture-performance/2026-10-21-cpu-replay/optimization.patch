+#[cfg(test)]
+mod temporal_bound_regressions {
+    use super::*;
+    #[test]
+    fn conservative_temporal_bounds_preserve_position_only_oracle_and_reset_inputs() {
+        let count = PARALLEL_ADMISSION_MIN_VERTICES + 17;
+        let mut outcomes = std::collections::BTreeSet::new();
+        for normal in [[0.,1.,0.], [0.;3], [f32::MAX,0.,0.]] {
+            let vertices = (0..count).map(|i| SkinnedVertex {
+                position: [(i % 71) as f32 * 0.03, -0.2, 0.3], normal,
+                uv:[0.;2],joints:[(i%2) as u16,0,0,0],weights:[65535,0,0,0],
+            }).collect();
+            let mesh=SkinnedMesh::new(vertices,vec![0,1,2],2).unwrap();
+            let shared=mesh.with_shared_indices(Arc::from([2,1,0])).unwrap();
+            for joints in [
+                [Mat4::IDENTITY,Mat4::from_rotation_y(0.3)],
+                [Mat4::from_scale(glam::Vec3::ZERO);2],
+                [Mat4::from_scale(glam::Vec3::new(1.,0.,1.));2],
+            ] {
+                for model in [Mat4::IDENTITY,Mat4::from_scale(glam::Vec3::splat(-1.)),Mat4::from_scale(glam::Vec3::splat(f32::MAX))] {
+                    let reference=admit_temporal_vertices(mesh.vertices(),&joints,model,mesh.coherent_weights);
+                    let certified=finite_temporal_positions(mesh.max_position_component,&joints,model);
+                    assert!(!certified || reference.is_ok());
+                    outcomes.insert((certified,reference.is_ok()));
+                    assert_eq!(mesh.validate_temporal_pose(&joints,model),reference);
+                    assert_eq!(shared.validate_temporal_pose(&joints,model),reference);
+                }
+            }
+            let large_translation = Mat4::from_translation(glam::Vec3::splat(f32::MAX/8.));
+            assert!(!finite_temporal_positions(mesh.max_position_component,&[Mat4::IDENTITY;2],large_translation));
+            let reference=admit_temporal_vertices(mesh.vertices(),&[Mat4::IDENTITY;2],large_translation,false);
+            assert!(reference.is_ok());
+            assert_eq!(mesh.validate_temporal_pose(&[Mat4::IDENTITY;2],large_translation),reference);
+            outcomes.insert((false,true));
+            for palette in [vec![],vec![Mat4::IDENTITY],vec![Mat4::from_cols_array(&[f32::NAN;16]);2]] {
+                let expected=validate_temporal_palette(&mesh,&palette,Mat4::IDENTITY);
+                assert!(expected.is_err());
+                assert_eq!(mesh.validate_temporal_pose(&palette,Mat4::IDENTITY),expected);
+            }
+            // Replacing the model/palette on each call must not retain a certificate.
+            assert!(mesh.validate_temporal_pose(&[Mat4::IDENTITY;2],Mat4::IDENTITY).is_ok());
+            assert!(mesh.validate_temporal_pose(&[Mat4::IDENTITY;2],Mat4::from_scale(glam::Vec3::splat(f32::MAX))).is_err());
+            assert!(mesh.validate_temporal_pose(&[Mat4::IDENTITY;2],Mat4::IDENTITY).is_ok());
+        }
+        assert_eq!(outcomes.into_iter().collect::<Vec<_>>(),vec![(false,false),(false,true),(true,true)]);
+    }
+}
