+// Audit readback happens after the measured frame samples have been collected.
+fn original_gi_queue_words(gpu: &Gpu) -> Result<[u32; 10], Box<dyn std::error::Error>> {
+    let source = gpu.renderer.opaque_ray_queue_proof_buffer().ok_or("missing original GI queue proof buffer")?;
+    let read = gpu.device.create_buffer(&wgpu::BufferDescriptor {
+        label: Some("original GI queue proof readback"), size: 40,
+        usage: wgpu::BufferUsages::MAP_READ | wgpu::BufferUsages::COPY_DST, mapped_at_creation: false,
+    });
+    let mut encoder = gpu.device.create_command_encoder(&Default::default());
+    encoder.copy_buffer_to_buffer(source, 0, &read, 0, 40);
+    let submission = gpu.queue.submit([encoder.finish()]);
+    gpu.device.poll(wgpu::PollType::Wait { submission_index: Some(submission), timeout: None })?;
+    let (send, receive) = std::sync::mpsc::channel();
+    read.slice(..).map_async(wgpu::MapMode::Read, move |r| { let _ = send.send(r); });
+    gpu.device.poll(wgpu::PollType::wait_indefinitely())?;
+    receive.recv()??;
+    let bytes = read.slice(..).get_mapped_range()?;
+    Ok(std::array::from_fn(|i| u32::from_le_bytes(bytes[i*4..i*4+4].try_into().unwrap())))
+}
+// Compare actual raw GI outputs with the original raster query, before HDR/TAA.
+fn original_gi_raster_comparison(gpu: &Gpu) -> Result<serde_json::Value, Box<dyn std::error::Error>> {
+    let (actual, reference) = gpu.renderer.opaque_gi_precision_textures().ok_or("missing raw raster GI reference")?;
+    let width=actual.width();let height=actual.height();
+    if reference.size()!=actual.size() || actual.format()!=wgpu::TextureFormat::Rgba32Float
+        || reference.format()!=wgpu::TextureFormat::Rgba32Float {return Err("GI comparison format mismatch".into());}
+    let row=width*16;let pitch=row.div_ceil(256)*256;let image_bytes=u64::from(pitch)*u64::from(height);
+    let read=gpu.device.create_buffer(&wgpu::BufferDescriptor {
+        label:Some("raw original-vs-queued GI words"),size:image_bytes*2,
+        usage:wgpu::BufferUsages::COPY_DST|wgpu::BufferUsages::MAP_READ,mapped_at_creation:false,
+    });
+    let mut encoder=gpu.device.create_command_encoder(&Default::default());
+    for (i,texture) in [actual,reference].into_iter().enumerate() {
+        encoder.copy_texture_to_buffer(texture.as_image_copy(),wgpu::TexelCopyBufferInfo {
+            buffer:&read,layout:wgpu::TexelCopyBufferLayout {offset:i as u64*image_bytes,bytes_per_row:Some(pitch),rows_per_image:Some(height)}
+        },texture.size());
+    }
+    let submission=gpu.queue.submit([encoder.finish()]);
+    gpu.device.poll(wgpu::PollType::Wait {submission_index:Some(submission),timeout:None})?;
+    let (send,receive)=std::sync::mpsc::channel();read.slice(..).map_async(wgpu::MapMode::Read,move|r|{let _=send.send(r);});
+    gpu.device.poll(wgpu::PollType::wait_indefinitely())?;receive.recv()??;
+    let bytes=read.slice(..).get_mapped_range()?;
+    let mut hashes=[blake3::Hasher::new(),blake3::Hasher::new()];let mut different=0u64;let mut nonfinite=0u64;
+    let mut maximum=0f64;let mut first=Vec::new();
+    for y in 0..height as usize {
+        let a=&bytes[y*pitch as usize..y*pitch as usize+row as usize];
+        let b=&bytes[image_bytes as usize+y*pitch as usize..image_bytes as usize+y*pitch as usize+row as usize];
+        hashes[0].update(a);hashes[1].update(b);
+        for (i,(a,b)) in a.chunks_exact(4).zip(b.chunks_exact(4)).enumerate() {
+            let wa=u32::from_le_bytes(a.try_into().unwrap());let wb=u32::from_le_bytes(b.try_into().unwrap());
+            let fa=f32::from_bits(wa);let fb=f32::from_bits(wb);
+            if !fa.is_finite()||!fb.is_finite(){nonfinite+=1;}else{maximum=maximum.max((f64::from(fa)-f64::from(fb)).abs());}
+            if wa!=wb {
+                different+=1;
+                if first.len()<16 {first.push(serde_json::json!({"x":i/4,"y":y,"channel":i%4,"queued_bits":wa,"raster_bits":wb}));}
+            }
+        }
+    }
+    let input_mode=std::env::var("VOXY_STREET_GI_INPUT_DIAGNOSTIC").ok().and_then(|v|v.parse::<u32>().ok()).unwrap_or(0);
+    Ok(serde_json::json!({"scope":if input_mode==0 {"last completed frame raw Float32 GI, before HDR/TAA"} else {"input tuple diagnostic, no GI timing qualification"},"input_mode":input_mode,
+        "width":width,"height":height,"compared_words":u64::from(width)*u64::from(height)*4,
+        "different_words":different,"nonfinite_pairs":nonfinite,"max_absolute_error":maximum,
+        "strict_parity_passed":different==0&&nonfinite==0,"first_differences":first,
+        "actual_blake3":hashes[0].finalize().to_hex().to_string(),"raster_blake3":hashes[1].finalize().to_hex().to_string()}))
+}
