diff --git a/crates/voxy_render/src/archive_gi_compare_depth.wgsl b/crates/voxy_render/src/archive_gi_compare_depth.wgsl
new file mode 100644
index 000000000..e47139d00
--- /dev/null
+++ b/crates/voxy_render/src/archive_gi_compare_depth.wgsl
@@ -0,0 +1,9 @@
+
+// Exact nearest comparison preserves all original binary-search decisions.
+@group(2) @binding(11) var gi_depth_compare:sampler_comparison;
+fn archive_gi_depth_crossed(pixel:vec2<i32>,reference:f32)->bool {
+ let uv=(vec2<f32>(pixel)+0.5)/camera.viewport.xy;
+ let crossed=textureSampleCompareLevel(scene_depth,gi_depth_compare,uv,reference)>0.;
+ // A clear-depth texel must remain a miss even beyond the far clip plane.
+ return crossed&&(reference<1.||textureLoad(scene_depth,pixel,0)<1.);
+}
