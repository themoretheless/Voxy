+/// Private experimental specialization keeps other shader owners unchanged.
+fn archive_shader_source_compare_depth(enabled:bool)->String {
+    let mut source=archive_shader_source();
+    if !enabled {return source;}
+    let start=source.find("fn screen_reflection_original(").expect("original query");
+    let end=source[start..].find("// Screen-space one-bounce GI").expect("original query end")+start;
+    let mut query=source[start..end].replace("fn screen_reflection_original(","fn screen_reflection_compare_depth(");
+    let refine=r#"    var z=1.;
+    if bounded && ARCHIVE_REFINE_CACHE {
+     if any(pixel!=cached_pixel) {cached_depth=textureLoad(scene_depth,pixel,0);cached_pixel=pixel;}
+     z=cached_depth;
+    } else {z=textureLoad(scene_depth,pixel,0);}
+    if z<1.&&clip.z/clip.w>=z {hi=mid;} else {lo=mid;}"#;
+    assert!(query.contains(refine));
+    query=query.replacen(refine,"    if archive_gi_depth_crossed(pixel,clip.z/clip.w) {hi=mid;} else {lo=mid;}",1);
+    let original=" return screen_reflection(p+n*0.05,direction,true,60.,1.,8u,ARCHIVE_RAY_BOUNDS);";
+    assert!(source.contains(original));
+    source=source.replacen(original," if !ARCHIVE_PAIRED_DDA&&!ARCHIVE_REFINE_CACHE {return screen_reflection_compare_depth(p+n*0.05,direction,true,60.,1.,8u,ARCHIVE_RAY_BOUNDS); }\n return screen_reflection(p+n*0.05,direction,true,60.,1.,8u,ARCHIVE_RAY_BOUNDS);",1);
+    source.push_str(include_str!("archive_gi_compare_depth.wgsl"));source.push_str(&query);source
+}
+#[cfg(test)]
+mod gi_compare_depth_tests {
+    #[test]
+    fn native_specialization_validates_and_default_module_is_unchanged() {
+        assert_eq!(super::archive_shader_source_compare_depth(false),super::archive_shader_source());
+        let source=super::archive_shader_source_compare_depth(true);
+        let module=naga::front::wgsl::parse_str(&source).unwrap();
+        naga::valid::Validator::new(naga::valid::ValidationFlags::all(),naga::valid::Capabilities::all()).validate(&module).unwrap();
+    }
+}
