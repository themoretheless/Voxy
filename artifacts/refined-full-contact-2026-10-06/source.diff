+        assert_eq!((alpha, norm), (0., 4.));
+        assert!(project_branch_segment(&first, &second, &[0., 1.], &[false, true]).is_err());
+        assert!(project_branch_segment(&first, &second, &[4., 1.], &[false]).is_err());
+    }
