+        let storage=pollster::block_on(crate::ComputeProgram::new(&device,JOINT_CONTACT_EQUALITY_SHADER)).unwrap();
+        let cached=pollster::block_on(crate::ComputeProgram::new(&device,include_str!("joint_contact_equality_cached.wgsl"))).unwrap();
+        for count in [2,61,133,256,257] {
+            let columns:Vec<Vec<f64>>=(0..count).map(|j|(0..count+3).map(|i| {
+                if i==j {1.} else if i<j {0.03*((i*13+j*7)%19) as f64/19.} else {0.}
+            }).collect()).collect();
+            let bounds:Vec<_>=(0..count).map(|i|if i%3==0 {-0.7} else {(i+1) as f64/count as f64}).collect();
+            let input=ResidentContactEqualityInput::new_with_support_compaction(&columns,&bounds,false).unwrap();
+            let mut job=qr.create_job(&device,input.bytes()).unwrap();
+            let mut encoder=device.create_command_encoder(&Default::default());
+            job.encode_repeated_steps(&mut encoder,[1,1,1],count as u32).unwrap();
+            let submission=queue.submit([encoder.finish()]);
+            device.poll(wgpu::PollType::Wait {submission_index:Some(submission),timeout:None}).unwrap();
+            let run=|job:&mut crate::ComputeJob,program:&crate::ComputeProgram| {
+                job.use_program(program).unwrap();
+                let started=std::time::Instant::now();
+                let mut encoder=device.create_command_encoder(&Default::default());
+                job.encode_step(&mut encoder,[1,1,1]).unwrap();
+                let dispatch=job.encode_snapshot(&mut encoder).unwrap();
+                let submission=queue.submit([encoder.finish()]);
+                let mut read=dispatch.begin_read();
+                device.poll(wgpu::PollType::Wait {submission_index:Some(submission),timeout:None}).unwrap();
+                (read.try_read().unwrap().unwrap(),started.elapsed().as_secs_f64()*1000.)
+            };
+            let baseline=run(&mut job,&storage).0;
+            assert_eq!(run(&mut job,&cached).0,baseline,"cache warm-up changed output bits count={count}");
+            let mut old_times=Vec::new();let mut new_times=Vec::new();
+            for pair in 0..8 {
+                for cache in [pair%2==0,pair%2!=0] {
+                    let (bytes,ms)=run(&mut job,if cache {&cached} else {&storage});
+                    assert_eq!(bytes,baseline,"cache changed full storage bits count={count} pair={pair}");
+                    if cache {new_times.push(ms);} else {old_times.push(ms);}
+                }
+            }
